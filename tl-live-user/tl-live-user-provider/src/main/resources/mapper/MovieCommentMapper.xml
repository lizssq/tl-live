<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.tl.user.provider.mapper.MovieCommentMapper">

    <resultMap id="BaseResultMap" type="org.tl.user.provider.entity.MovieComment">
            <id property="commentId" column="comment_id" />
            <result property="userId" column="user_id" />
            <result property="movieId" column="movie_id" />
            <result property="content" column="content" />
            <result property="rating" column="rating" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
    </resultMap>

    <resultMap id="CommentWithUserInfoResultMap" type="org.tl.user.provider.entity.MovieComment">
        <id property="commentId" column="comment_id"/>
        <result property="userId" column="user_id"/>
        <result property="movieId" column="movie_id"/>
        <result property="content" column="content"/>
        <result property="rating" column="rating"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="nickName" column="nick_name"/>
        <result property="avatar" column="avatar"/>
    </resultMap>

    <sql id="Base_Column_List">
        comment_id,user_id,movie_id,content,rating,status,
        create_time
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from movie_comment
        where  comment_id = #{commentId} 
    </select>
    <select id="getCommentWithUserInfo" resultMap="CommentWithUserInfoResultMap">
        SELECT
            mc.comment_id,
            mc.user_id,
            mc.movie_id,
            mc.content,
            mc.rating,
            mc.status,
            mc.create_time,
            u.nick_name,
            u.avatar
        FROM
            movie_comment mc
                LEFT JOIN
            t_user u ON mc.user_id = u.user_id
        WHERE
            mc.movie_id = #{movie_id}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from movie_comment
        where  comment_id = #{commentId} 
    </delete>
    <insert id="insert" keyColumn="comment_id" keyProperty="commentId" parameterType="org.tl.user.provider.entity.MovieComment" useGeneratedKeys="true">
        insert into movie_comment
        ( comment_id,user_id,movie_id,content,rating,status,
        create_time)
        values (#{commentId},#{userId},#{movieId},#{content},#{rating},#{status},
        #{createTime})
    </insert>
    <insert id="insertSelective" keyColumn="comment_id" keyProperty="commentId" parameterType="org.tl.user.provider.entity.MovieComment" useGeneratedKeys="true">
        insert into movie_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="commentId != null">comment_id,</if>
                <if test="userId != null">user_id,</if>
                <if test="movieId != null">movie_id,</if>
                <if test="content != null">content,</if>
                <if test="rating != null">rating,</if>
                <if test="status != null">status,</if>
                <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="commentId != null">#{commentId},</if>
                <if test="userId != null">#{userId},</if>
                <if test="movieId != null">#{movieId},</if>
                <if test="content != null">#{content},</if>
                <if test="rating != null">#{rating},</if>
                <if test="status != null">#{status},</if>
                <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="org.tl.user.provider.entity.MovieComment">
        update movie_comment
        <set>
                <if test="userId != null">
                    user_id = #{userId},
                </if>
                <if test="movieId != null">
                    movie_id = #{movieId},
                </if>
                <if test="content != null">
                    content = #{content},
                </if>
                <if test="rating != null">
                    rating = #{rating},
                </if>
                <if test="status != null">
                    status = #{status},
                </if>
                <if test="createTime != null">
                    create_time = #{createTime},
                </if>
        </set>
        where   comment_id = #{commentId} 
    </update>
    <update id="updateByPrimaryKey" parameterType="org.tl.user.provider.entity.MovieComment">
        update movie_comment
        set 
            user_id =  #{userId},
            movie_id =  #{movieId},
            content =  #{content},
            rating =  #{rating},
            status =  #{status},
            create_time =  #{createTime}
        where   comment_id = #{commentId} 
    </update>
</mapper>
