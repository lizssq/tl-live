                <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="org.tl.user.provider.entity.LiveCategory">
        update live_category
        <set>
                <if test="name != null">
                    name = #{name},
                </if>
                <if test="slug != null">
                    slug = #{slug},
                </if>
                <if test="description != null">
                    description = #{description},
                </if>
                <if test="coverUrl != null">
                    cover_url = #{coverUrl},
                </if>
                <if test="icon != null">
